# Required by docker compose
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Base64-encoded key of sufficient length for HS256
JWT_SECRET_KEY=replace-with-a-base64-encoded-jwt-signing-key

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP delivery for verification links
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Public URLs used by the browser and OAuth callback
FRONTEND_API_URL=http://localhost:8080/api
FRONTEND_WS_URL=ws://localhost:8080/ws
