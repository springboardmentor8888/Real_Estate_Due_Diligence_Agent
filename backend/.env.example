# Copy to .env for local development and provide real values locally.
DB_URL=jdbc:postgresql://localhost:5432/real_estate_due_diligence
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Base64-encoded key of sufficient length for HS256.
JWT_SECRET_KEY=replace-with-a-base64-encoded-jwt-signing-key
VERIFICATION_TOKEN_EXPIRATION_MINUTES=1440
# Comma-separated exact hostnames permitted for outbound provider calls.
EXTERNAL_API_ALLOWED_HOSTS=api.example.com
# Optional SMTP delivery for verification links
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-username
SPRING_MAIL_PASSWORD=your-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
